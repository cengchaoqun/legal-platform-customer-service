# 运行环境：dev / test / prod
APP_ENV=dev
AI_DATABASE_URL=postgresql+psycopg://legal:legal_dev_password@127.0.0.1:55432/ai_customer_service
API_HOST=0.0.0.0
API_PORT=8002
INTERNAL_SERVICE_TOKEN=legal-support-internal-token
JWT_SECRET=legal-support-local-secret
JWT_ALGORITHM=HS256

# 法律平台业务服务（没有真实接口时指向本地演示服务）
LEGAL_PLATFORM_BASE_URL=http://127.0.0.1:8001/api/v1
LEGAL_PLATFORM_TIMEOUT_SECONDS=8

# DeepSeek 官方 API；密钥只放在本机环境变量或未提交的 .env
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=30
LLM_HEALTHCHECK_ENABLED=true
LLM_HEALTHCHECK_TIMEOUT_SECONDS=15
MODEL_ARTIFACT_VERSION=deepseek-api-v1
MODEL_DEPLOYMENT_ID=deepseek-cloud
POLICY_RUNTIME_MODE=deployed
ALLOW_FIXTURE_MODEL=false

CONTRACT_VERSION=legal-support-v2
FLOW_DEFINITION_VERSION=legal-support-flow-v1
POLICY_PROMPT_VERSION=legal-policy-v1
EXECUTION_PROMPT_VERSION=legal-execution-v1
MAX_MODEL_CALLS=3
MAX_TOOL_CALLS=8
MAX_CORRECTIONS=1
ROUND_TIMEOUT_SECONDS=45
PROFESSIONAL_REVIEW_AVAILABLE=false
